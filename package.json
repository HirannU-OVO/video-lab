{
  "name": "video-lab",
  "version": "2.6.0",
  "description": "Video Lab",
  "author": "HirannU",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "node run.js"
  },
  "build": {
    "appId": "com.videolab.manager",
    "productName": "Video Lab",
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/HirannU-OVO/video-lab/releases/latest/download"
      }
    ],
    "directories": {
      "output": "../../../Setup"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "backend.js",
      "server.js",
      "engines/engine-runner.js",
      "engines/registry.js",
      "engines/base/**/*",
      "engines/modules/**/*",
      "engines/tools/**/*",
      "frontend/**/*",
      "icon/**/*",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "LICENSE-ARTWORK",
      "NOTICE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engines",
        "to": "Engines",
        "filter": [
          "**/*",
          "!tests/**"
        ]
      },
      {
        "from": "../ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "icon": "icon/app-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Lab",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "Video-Lab-${version}-x64-Setup.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
